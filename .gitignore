# =========================================================
# TalentCircuit — Full-Stack Gitignore (Next.js + Node.js)
# Safe for GitHub, Cloudflare, Vercel, Render, Railway, etc.
# =========================================================

# -------------------------
# Node.js (Backend + Frontend)
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml
package-lock.json

# -------------------------
# Environment Variables
# NEVER commit secrets
# -------------------------
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
.env.*.local

# -------------------------
# Next.js Build Output
# -------------------------
.next/
out/
build/
dist/

# -------------------------
# TypeScript
# -------------------------
*.tsbuildinfo

# -------------------------
# Logs
# -------------------------
logs/
*.log
*.log.*
debug.log

# -------------------------
# OS Junk
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# IDE / Editor
# -------------------------
.vscode/
.idea/
*.swp

# -------------------------
# Misc
# -------------------------
coverage/
.cache/
